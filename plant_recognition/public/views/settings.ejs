<!doctype html>
<html lang="en">
<%- include('partials/head', { title: text.settings.title, styles: ['/css/variables.css', '/css/themes.css', '/css/layout.css', '/css/components.css', '/css/scrollbars.css', '/css/popups.css'] }) %>
  <script>
    try {
      var dark = localStorage.getItem('darkMode') !== 'false';
      document.documentElement.classList.add(dark ? 'dark-mode' : 'light-mode');

    } catch(e) {}
  </script>

<body class="settings-page">
  <%- include('partials/nav') %>

  <div class="container container-narrow">
    <h1 class="page-header"><%= text.settings.header %></h1>

    <div class="setting-item">
      <label for="theme-toggle"><%= text.settings.dark_mode_label %></label>
      <input type="checkbox" id="theme-toggle">
    </div>



    <div class="setting-item">
      <label for="language-select"><%= text.settings.language_label %></label>
      <select id="language-select">
        <option value="en" <%= currentLang === 'en' ? 'selected' : '' %>><%= text.settings.language_en_option %></option>
        <option value="afr" <%= currentLang === 'afr' ? 'selected' : '' %>><%= text.settings.language_afr_option %></option>
        <option value="zulu" <%= currentLang === 'zulu' ? 'selected' : '' %>><%= text.settings.language_zulu_option %></option>
      </select>
    </div>


    <div class="setting-item storage-preference">
      <label for="storage-preference">File Storage</label>
      <select id="storage-preference">
        <option value="server">Server Storage (2GB total, 90 days retention)</option>
        <option value="local">Local Storage (Unlimited, device only)</option>
      </select>
      <div class="setting-help">
        <p id="storage-description">Choose how your files (images, videos, frames) are stored:</p>
        <ul>
          <li><strong>Server Storage:</strong> Files saved to server with 2GB total storage. Kept for 90 days and accessible from any device.</li>
          <li><strong>Local Storage:</strong> Files stored only on this device. Unlimited space.</li>
        </ul>
        <p id="storage-warning" class="warning hidden">NOTE: Switching to local storage will keep your server files for 90 days, then they will be automatically removed.</p>
      </div>
    </div>

    <div class="setting-item local-storage-options hidden" id="local-storage-options">
      <label>Local Storage Location</label>
      <div class="storage-location-info">
        <p>Current location: <span id="current-storage-location">Browser Storage</span></p>
        <button type="button" id="select-storage-folder" class="button button-secondary">
          Select Folder
        </button>
        <div class="setting-help">
          <p><strong>Browser Storage:</strong> Files stored in browser's internal storage (IndexedDB)</p>
          <p><strong>Custom Folder:</strong> Choose a folder on your device (requires modern browser support)</p>
        </div>
      </div>
    </div>

    <div class="button-group button-group-end">
      <button id="cancel-btn" type="button"><%= text.settings.cancel_button %></button>
      <a class="button" href="/app" id="apply-btn"><%= text.settings.apply_button %></a>
    </div>
  </div>

  <script src="/js/modal.js"></script>
  <script type="module" src="/js/settings.js"></script>
</body>
</html>
