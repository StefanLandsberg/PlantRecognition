<!doctype html>
<html lang="en">
<%- include('partials/head', { title: text.title, styles: ['/css/variables.css', '/css/themes.css', '/css/layout.css', '/css/components.css'] }) %>
  <style>
    /* Override any potential white borders */
    *, *::before, *::after {
      border: none !important;
      outline: none !important;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3) !important;
    }
    html, body {
      border: none !important;
      outline: none !important;
      margin: 0 !important;
      padding: 0 !important;
      background: var(--bg) !important;
    }
    .form-container {
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3) !important;
      border: none !important;
    }
  </style>

  <body>
    <div class="center-card">
      <h1><%= text.login.header %></h1>
      <form id="login-form" class="auth-form form-container">
        <label for="login-username"><%= text.login.username_label %></label>
        <input id="login-username" name="username" type="text" required />
        <label for="login-password"><%= text.login.password_label %></label>
        <input id="login-password" name="password" type="password" required />
        <button type="submit"><%= text.login.signin_button %></button>
        <div id="login-error" class="error"></div>

        <button id="show-register-link" type="button" class="hidden-link auth-link">
          <%= text.login.new_here_link %>
        </button>
      </form>

      <form id="register-form" class="auth-form form-container hidden">
        <label for="register-username"><%= text.register.username_label %></label>
        <input id="register-username" name="username" type="text" required />
        <label for="register-email"><%= text.register.email_label %></label>
        <input id="register-email" name="email" type="email" required />
        <label for="register-password"><%= text.register.password_label %></label>
        <input id="register-password" name="password" type="password" required minlength="8" />
        <div id="password-requirements" class="helper-password">
          <p id="length" class="requirement invalid"><%= text.register.length_req %></p>
          <p id="uppercase" class="requirement invalid"><%= text.register.uppercase_req %></p>
          <p id="number" class="requirement invalid"><%= text.register.number_req %></p>
          <p id="special" class="requirement invalid"><%= text.register.special_req %></p>
        </div>
        <label for="register-confirm-password"><%= text.register.confirm_password_label %></label>
        <input id="register-confirm-password" name="confirm-password" type="password" required minlength="8" />
        <button type="submit"><%= text.register.register_button %></button>
        <div id="register-error" class="error"></div>
        <button id="show-login-link" type="button" class="hidden-link auth-link">
          <%= text.register.already_account_link %>
        </button>
      </form>
    </div>

    <script type="module" src="/js/auth.js"></script>
  </body>

</html>